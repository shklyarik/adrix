{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adrix",
  "version": "0.1.0",
  "identifier": "dev.adrix.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "msi",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Adminer desktop client with SSH tunnels",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/php"
    ],
    "resources": {
      "../php/router.php": "adminer/router.php",
      "../php/entry.php": "adminer/entry.php",
      "../php/adrix-plugin.php": "adminer/adrix-plugin.php",
      "../php/adminer.php": "adminer/adminer.php",
      "../dist/": "ui/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/Apache-2.0.txt": "licenses/Apache-2.0.txt",
      "../licenses/PHP-3.01.txt": "licenses/PHP-3.01.txt"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 Pavel"
  }
}

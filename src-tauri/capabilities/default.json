{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local window (dev mode, devUrl). In release the window loads http://127.0.0.1:PORT; that capability is added at runtime (see lib.rs).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-list-connections",
    "allow-save-connection",
    "allow-delete-connection",
    "allow-reorder-connections",
    "allow-test-connection",
    "allow-open-session",
    "allow-close-session",
    "allow-forget-host-key",
    "allow-save-settings",
    "allow-pick-file",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom"
  ]
}
